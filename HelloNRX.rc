#include "resource.h"
#include "afxres.h"

LANGUAGE LANG_RUSSIAN, SUBLANG_DEFAULT

IDD_ALIGN_PIPE DIALOGEX 0, 0, 440, 355
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "PIPE_ALIGN"
FONT 9, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "",IDC_STATIC_INFO,7,7,426,12
    GROUPBOX        "Node coordinates",IDC_STATIC,7,22,426,130
    LISTBOX         IDC_LIST_COORDS,14,36,412,55,LBS_NOTIFY | LBS_NOINTEGRALHEIGHT | WS_VSCROLL | WS_TABSTOP
    LTEXT           "X:",IDC_STATIC,14,98,12,10
    EDITTEXT        IDC_EDIT_X,28,96,70,14,ES_AUTOHSCROLL
    LTEXT           "Y:",IDC_STATIC,108,98,12,10
    EDITTEXT        IDC_EDIT_Y,122,96,70,14,ES_AUTOHSCROLL
    LTEXT           "Z:",IDC_STATIC,202,98,12,10
    EDITTEXT        IDC_EDIT_Z,216,96,70,14,ES_AUTOHSCROLL
    PUSHBUTTON      "Apply XYZ",IDC_BTN_APPLY_XYZ,296,96,60,14
    PUSHBUTTON      "Round",IDC_BTN_ROUND_XYZ,360,96,66,14
    CONTROL         "WCS ortho XYZ",IDC_CHK_ORTHO,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,14,116,160,10
    CONTROL         "Lock mid terminators",IDC_CHK_PROTECT_TERM,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,180,116,130,10
    PUSHBUTTON      "Align all XYZ",IDC_BTN_ALIGN_COORDS,320,114,106,14
    LTEXT           "",IDC_STATIC_XYZ,14,134,412,12
    GROUPBOX        "Elbows",IDC_STATIC,7,158,426,160
    LISTBOX         IDC_LIST_ELBOWS,14,172,412,70,LBS_NOTIFY | LBS_NOINTEGRALHEIGHT | WS_VSCROLL | WS_TABSTOP
    LTEXT           "",IDC_STATIC_ANGLE_CUR,14,248,300,10
    LTEXT           "Turn:",IDC_STATIC,14,268,28,10
    EDITTEXT        IDC_EDIT_ANGLE,44,266,50,14,ES_AUTOHSCROLL
    PUSHBUTTON      "Apply turn",IDC_BTN_APPLY_ELBOW_ANGLE,100,266,80,14
    PUSHBUTTON      "Snap turns",IDC_BTN_ALIGN_ALL_ELBOWS,186,266,240,14
    LTEXT           "",IDC_STATIC_ELBOW_HINT,14,288,412,24
    DEFPUSHBUTTON   "Close",IDCANCEL,383,332,50,14
END

IDD_INSUL DIALOGEX 0, 0, 560, 420
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Изоляция котлов (НР 34)"
FONT 9, "MS Shell Dlg", 400, 0, 0xCC
BEGIN
    CONTROL         "",IDC_INSUL_TAB,"SysTabControl32",0x0,7,7,546,28

    LTEXT           "Регион:",IDC_STATIC,10,42,40,10
    COMBOBOX        IDC_INSUL_CMB_REGION,55,40,350,160,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Среда:",IDC_STATIC,10,64,40,10
    COMBOBOX        IDC_INSUL_CMB_MEDIA,55,62,160,80,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Температура, C:",IDC_STATIC,230,64,70,10
    EDITTEXT        IDC_INSUL_EDIT_T,305,62,50,14,ES_AUTOHSCROLL
    LTEXT           "",IDC_INSUL_STATIC_D,10,84,400,10
    PUSHBUTTON      "Рассчитать",IDC_INSUL_BTN_CALC,10,100,90,16
    PUSHBUTTON      "Назначить изоляцию",IDC_INSUL_BTN_ASSIGN,110,100,130,16
    LTEXT           "",IDC_INSUL_STATIC_RESULT,250,102,200,12
    GROUPBOX        "Полный расчёт",IDC_STATIC,10,120,540,270
    EDITTEXT        IDC_INSUL_EDIT_REPORT,18,136,524,244,ES_MULTILINE | ES_AUTOVSCROLL | ES_READONLY | WS_VSCROLL | WS_TABSTOP

    CONTROL         "",IDC_INSUL_LIST_ZONES,"SysListView32",LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS | WS_BORDER | WS_TABSTOP,10,42,540,250
    CONTROL         "Делить трассу по сварному шву (Weld)",IDC_INSUL_CHK_SPLIT_WELD,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,10,298,260,12
    LTEXT           "Регион для отмеченных:",IDC_STATIC,10,318,100,10
    COMBOBOX        IDC_INSUL_CMB_REGION2,115,316,280,160,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Среда:",IDC_STATIC,10,340,40,10
    COMBOBOX        IDC_INSUL_CMB_MEDIA2,55,338,120,80,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "t, C:",IDC_STATIC,185,340,25,10
    EDITTEXT        IDC_INSUL_EDIT_T2,215,338,45,14,ES_AUTOHSCROLL
    PUSHBUTTON      "Применить к отмеченным",IDC_INSUL_BTN_APPLY_ROW,270,338,130,14
    PUSHBUTTON      "Обновить",IDC_INSUL_BTN_REFRESH,10,362,70,16
    PUSHBUTTON      "Все",IDC_INSUL_BTN_SEL_ALL,85,362,40,16
    PUSHBUTTON      "Снять",IDC_INSUL_BTN_SEL_NONE,130,362,45,16
    PUSHBUTTON      "Рассчитать отмеченные",IDC_INSUL_BTN_CALC_ALL,185,362,130,16
    PUSHBUTTON      "Назначить отмеченные",IDC_INSUL_BTN_ASSIGN_ALL,325,362,130,16
    LTEXT           "",IDC_INSUL_STATIC_BATCH,10,384,440,12

    DEFPUSHBUTTON   "Закрыть",IDCANCEL,490,396,60,14
    COMBOBOX        IDC_INSUL_CMB_NORM,10,400,10,10,CBS_DROPDOWNLIST | NOT WS_VISIBLE
    COMBOBOX        IDC_INSUL_CMB_PLACE,30,400,10,10,CBS_DROPDOWNLIST | NOT WS_VISIBLE
END
